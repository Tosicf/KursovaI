<Window x:Class="StroyControl.App.Views.Dialogs.DeviationReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт по отклонениям"
        Width="1180" Height="860"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Отчёт по отклонениям от сметы" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="OnCloseClick" ToolTip="Закрыть">
                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Действия -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" Padding="12,5"
                            Background="{Binding SeverityBackground}">
                        <TextBlock Text="{Binding SummaryBadge}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{Binding SeverityForeground}" />
                    </Border>
                    <TextBlock Text="{Binding FormulaHint}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ExportButton" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0"
                            Click="OnExportClick" ToolTip="Выбрать формат файла отчёта">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Экспорт" Margin="6,0,6,0" VerticalAlignment="Center" />
                            <Path Data="M6 9l6 6 6-6" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                  Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                                  StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="CSV (.csv)" Click="OnCsvClick" />
                                <Separator />
                                <MenuItem Header="PDF" Click="OnPdfClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}" Click="OnPrintClick" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEstimates}" Stroke="White" StrokeThickness="1.7"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Печать" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Предпросмотр -->
        <Border Grid.Row="2" Margin="18" Background="White" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <FlowDocumentScrollViewer x:Name="Viewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False"
                                      Background="White" />
        </Border>
    </Grid>
</Window>
