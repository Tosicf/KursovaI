<Window x:Class="StroyControl.App.Views.Dialogs.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StroyControl.App.ViewModels.Editors"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="{Binding PreferredWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI"
        d:DataContext="{d:DesignInstance Type=vm:EditorViewModelBase}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="24,22,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnCloseClick" ToolTip="Закрыть">
                <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                      Width="14" Height="14" Stretch="Uniform" StrokeStartLineCap="Round" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" />

        <!-- Содержимое формы (шаблон выбирается по типу модели представления) -->
        <ScrollViewer Grid.Row="2" MaxHeight="{Binding ContentMaxHeight}" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
            <ContentControl Content="{Binding}" Focusable="False" />
        </ScrollViewer>

        <!-- Подвал -->
        <Border Grid.Row="3" Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                <Button Grid.Column="1" Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" Margin="0,0,10,0" MinWidth="110" />
                <Button Grid.Column="2" Content="{Binding SaveText}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" MinWidth="130" IsDefault="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
