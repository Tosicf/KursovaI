<Window xmlns:loc="clr-namespace:StroyControl.App.Localization"
        x:Class="StroyControl.App.Views.Dialogs.PurchaseReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Tr 'Счёт-фактура'}"
        Width="720" Height="820"
        MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{loc:Tr 'Счёт-фактура'}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Click="OnExportClick"
                            Height="36" Margin="0,0,10,0" ToolTip="{loc:Tr 'Печать счёта-фактуры или сохранение в PDF'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Stroke="White" StrokeThickness="1.7"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Tr 'Печать / PDF'}" Foreground="White" Margin="8,0,6,0" VerticalAlignment="Center" />
                            <Path Data="M6 9l6 6 6-6" Stroke="White" StrokeThickness="1.8"
                                  Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                                  StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Tr 'Печать…'}" Click="OnPrintClick" />
                                <Separator />
                                <MenuItem Header="PDF" Click="OnPdfClick" />
                                <MenuItem Header="Excel (.xlsx)" Click="OnExcelClick" />
                                <MenuItem Header="CSV (.csv)" Click="OnCsvClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnCloseClick" ToolTip="{loc:Tr 'Закрыть'}">
                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Предпросмотр -->
        <Border Grid.Row="1" Margin="18" Background="White" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <FlowDocumentScrollViewer x:Name="Viewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False"
                                      Background="White" />
        </Border>
    </Grid>
</Window>
