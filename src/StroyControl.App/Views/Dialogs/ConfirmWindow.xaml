<Window x:Class="StroyControl.App.Views.Dialogs.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Margin="18" Padding="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18" Color="#0F172A" />
        </Border.Effect>
        <StackPanel>
            <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource DangerSoftBrush}" HorizontalAlignment="Left">
                <Path Data="{StaticResource IconAlert}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.8"
                      Width="22" Height="22" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
            </Border>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,8" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" MinWidth="110" Margin="0,0,10,0"
                        IsCancel="True" Click="OnCancelClick" />
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" MinWidth="130"
                        IsDefault="True" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
