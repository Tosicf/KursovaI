<UserControl xmlns:loc="clr-namespace:StroyControl.App.Localization"
        x:Class="StroyControl.App.Views.EstimatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{loc:Tr 'Сметы и плановые потребности в материалах'}" Style="{StaticResource Caption}" FontSize="12.5" />
                <TextBlock Text="{loc:Tr 'Позиции сметы служат базой для расчёта отклонений'}" Style="{StaticResource Caption}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr 'Обновить'}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddEstimateCommand}" IsEnabled="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr 'Новая смета'}" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Перечень смет -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,0,10,0" />
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0"
                              VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="{loc:Tr 'Поиск сметы'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="36,0,10,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,10,0,12">
                        <ComboBox ItemsSource="{Binding ProjectFilterOptions}"
                                  SelectedItem="{Binding SelectedProjectFilter, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <controls:PeriodPicker DataContext="{Binding Period}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding EstimatesView}" SelectedItem="{Binding SelectedEstimate, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="12" Padding="14,12">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" Style="{StaticResource Badge}" Padding="8,2"
                                                    Background="{Binding Status, Converter={StaticResource EstimateStatusToBrush}, ConverterParameter=background}">
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource EstimateStatusToBrush}}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ProjectName, Mode=OneWay}" />
                                            <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding DateDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold"
                                                   Text="{Binding PlannedTotal, Converter={StaticResource Money}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <controls:EmptyState Title="{loc:Tr 'Смет пока нет'}"
                                             Description="{loc:Tr 'Создайте смету, чтобы планировать потребность в материалах по объекту.'}"
                                             Icon="{StaticResource IconEstimates}" ActionText="{loc:Tr 'Новая смета'}"
                                             ActionCommand="{Binding AddEstimateCommand}"
                                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <controls:EmptyState Title="{loc:Tr 'Сметы не найдены'}"
                                             Description="{loc:Tr 'Измените проект или поисковый запрос.'}"
                                             Icon="{StaticResource IconSearch}"
                                             Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="{loc:Tr 'Загружаем сметы…'}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Детали сметы -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Шапка сметы -->
                    <Grid Margin="20,18,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEstimate.Name, TargetNullValue=Выберите смету}" FontSize="17"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding SelectionHint}" />
                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    Visibility="{Binding IsSelectedFixed, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLock}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.6"
                                          Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusHint}" Margin="6,0,0,0" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding ShowReportCommand}"
                                    IsEnabled="{Binding CanViewReport}" Margin="0,0,8,0"
                                    ToolTip="{loc:Tr 'Отчёт по смете: расчёт работ и материалов, печать и выгрузка в Excel'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconEstimates}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr 'Отчёт'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding AddItemCommand}"
                                    CommandParameter="{Binding SelectedEstimate}" IsEnabled="{Binding CanEditSelected}" Margin="0,0,8,0"
                                    ToolTip="{loc:Tr 'Добавить позицию в черновик сметы (после подтверждения правки запрещены)'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr 'Позиция'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding ConfirmEstimateCommand}"
                                    IsEnabled="{Binding CanConfirmSelected}" Margin="0,0,8,0"
                                    ToolTip="{loc:Tr 'Подтвердить создание сметы: состав, количества и цены фиксируются без возможности изменения'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr 'Подтвердить'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding StartWorkCommand}"
                                    IsEnabled="{Binding CanStartWorkSelected}" Margin="0,0,8,0"
                                    ToolTip="{loc:Tr 'Смета утверждена: перевести её в работу, где план сравнивается с фактическими затратами'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource InfoBrush}" StrokeThickness="2"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr 'В работу'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding ArchiveEstimateCommand}"
                                    IsEnabled="{Binding CanArchiveSelected}" Margin="0,0,8,0"
                                    ToolTip="{loc:Tr 'Работы завершены: подтверждённая смета переносится во вкладку «Архив» (только чтение)'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBox}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr 'В архив'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="{loc:Tr 'Изменить реквизиты черновика'}" IsEnabled="{Binding CanEditSelected}"
                                    Command="{Binding EditEstimateCommand}" CommandParameter="{Binding SelectedEstimate}">
                                <Path Data="{StaticResource IconEdit}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                      Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="{loc:Tr 'Удалить черновик сметы'}" IsEnabled="{Binding CanEditSelected}"
                                    Command="{Binding DeleteEstimateCommand}" CommandParameter="{Binding SelectedEstimate}">
                                <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6"
                                      Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Сводка по смете: план, факт и отклонение -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" Padding="20,12" Margin="0,0,0,4">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- План: сумма сметы. После подтверждения она не меняется — факт сравнивается именно с ней. -->
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'План по смете'}" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="{Binding ItemsTotalDisplay}" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Факт: сумма актов списания, привязанных к этой смете -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Tr 'Фактические затраты'}" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="{Binding ActualCostDisplay}" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Tr 'Отклонение факта от плана'}" Style="{StaticResource Caption}" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding DeviationDisplay}" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{Binding DeviationLevel, Converter={StaticResource SeverityToBrush}}" />
                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Center"
                                            Background="{Binding DeviationLevel, Converter={StaticResource SeverityToBrush}, ConverterParameter=background}">
                                        <TextBlock Text="{Binding DeviationPercentDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding DeviationLevel, Converter={StaticResource SeverityToBrush}}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="16,0,0,0">
                                <TextBlock Text="{loc:Tr 'Позиций'}" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="{Binding ItemsCount}" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Column="4" Style="{StaticResource Badge}" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Background="{Binding SelectedEstimate.Status, Converter={StaticResource EstimateStatusToBrush}, ConverterParameter=background}">
                                <TextBlock Text="{Binding SelectedEstimate.StatusDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding SelectedEstimate.Status, Converter={StaticResource EstimateStatusToBrush}}" />
                            </Border>
                        </Grid>

                        <!-- Пояснение жизненного цикла: черновик → утверждение → работа (план сравнивается с фактом) -->
                        <TextBlock Text="{Binding PlanFactHint}" Style="{StaticResource Caption}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Позиции -->
                    <Grid Grid.Row="2">
                        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Items}" Margin="8,0,8,0">
                            <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Tr 'Отчёт по смете…'}"
                                      Command="{Binding PlacementTarget.DataContext.ShowReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanViewReport, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr 'Изменить позицию…'}" InputGestureText="F2"
                                      Command="{Binding PlacementTarget.DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{loc:Tr 'Удалить позицию'}" InputGestureText="Del"
                                      Command="{Binding PlacementTarget.DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr 'Добавить позицию'}"
                                      Command="{Binding PlacementTarget.DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{loc:Tr 'Обновить'}" InputGestureText="Ctrl+R"
                                      Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{loc:Tr 'Копировать'}" InputGestureText="Ctrl+C"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Tr 'Материал'}" Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MaterialName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SectionDisplay}" Style="{StaticResource Caption}"
                                                           FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Tr 'Вид'}" Width="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" Padding="8,2" HorizontalAlignment="Left"
                                                    Background="{Binding IsWork, Converter={StaticResource BoolToBrush}, ConverterParameter=PurpleSoftBrush|InfoSoftBrush}">
                                                <TextBlock Text="{Binding KindDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{Binding IsWork, Converter={StaticResource BoolToBrush}, ConverterParameter=PurpleBrush|InfoBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Кол-во'}" Binding="{Binding PlannedQuantity, StringFormat='{}{0:N2}', Mode=OneWay}" Width="100"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:Tr 'Ед.'}" Binding="{Binding UnitDisplay, Mode=OneWay}" Width="64" />
                                <DataGridTextColumn Header="{loc:Tr 'Цена, BYN'}" Binding="{Binding PlannedUnitPrice, StringFormat='{}{0:N2}', Mode=OneWay}" Width="110"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="{loc:Tr 'Сумма, BYN'}" Binding="{Binding PlannedCost, StringFormat='{}{0:N2}', Mode=OneWay}" Width="120"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{loc:Tr 'Изменить позицию'}"
                                                        IsEnabled="{Binding DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconEdit}" Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{loc:Tr 'Удалить позицию'}"
                                                        IsEnabled="{Binding DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}"
                                                          StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyState Title="{loc:Tr 'Выберите смету'}"
                                             Description="{loc:Tr 'Слева показан перечень смет. Выберите смету, чтобы увидеть её позиции.'}"
                                             Icon="{StaticResource IconEstimates}"
                                             Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <controls:EmptyState Title="{loc:Tr 'В смете нет позиций'}"
                                             Description="{loc:Tr 'Добавьте материалы с плановым количеством — на их основе будет считаться отклонение.'}"
                                             Icon="{StaticResource IconMaterials}" ActionText="{loc:Tr 'Добавить позицию'}"
                                             ActionCommand="{Binding AddItemCommand}"
                                             Visibility="{Binding IsItemsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Итог -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <Grid>
                            <TextBlock Text="{loc:Tr 'Итого по смете (план)'}" Style="{StaticResource Caption}" FontSize="12.5" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="Bold"
                                       Text="{Binding ItemsTotalDisplay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
