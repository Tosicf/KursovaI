<UserControl x:Class="StroyControl.App.Views.EstimatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Сметы и плановые потребности в материалах" Style="{StaticResource Caption}" FontSize="12.5" />
                <TextBlock Text="Позиции сметы служат базой для расчёта отклонений" Style="{StaticResource Caption}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Обновить" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddEstimateCommand}" IsEnabled="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Новая смета" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Перечень смет -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,0,10,0" />
                        <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0"
                              VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Поиск сметы" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="36,0,10,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>

                    <ComboBox Grid.Row="1" Margin="0,10,0,12" ItemsSource="{Binding ProjectFilterOptions}"
                              SelectedItem="{Binding SelectedProjectFilter, Mode=TwoWay}" />

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding EstimatesView}" SelectedItem="{Binding SelectedEstimate, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" Background="{StaticResource SurfaceAltBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="12" Padding="14,12">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" Style="{StaticResource Badge}" Padding="8,2"
                                                    Background="{Binding Status, Converter={StaticResource EstimateStatusToBrush}, ConverterParameter=background}">
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource EstimateStatusToBrush}}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Caption}" FontSize="11"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold"
                                                   Text="{Binding PlannedTotal, Converter={StaticResource Money}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <controls:EmptyState Title="Смет пока нет"
                                             Description="Создайте смету, чтобы планировать потребность в материалах по объекту."
                                             Icon="{StaticResource IconEstimates}" ActionText="Новая смета"
                                             ActionCommand="{Binding AddEstimateCommand}"
                                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <controls:EmptyState Title="Сметы не найдены"
                                             Description="Измените проект или поисковый запрос."
                                             Icon="{StaticResource IconSearch}"
                                             Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Загружаем сметы…" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Детали сметы -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Шапка сметы -->
                    <Grid Margin="20,18,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEstimate.Name, TargetNullValue=Выберите смету}" FontSize="17"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding SelectionHint}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Height="36" Command="{Binding AddItemCommand}"
                                    CommandParameter="{Binding SelectedEstimate}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Позиция" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Изменить смету" IsEnabled="{Binding CanEdit}"
                                    Command="{Binding EditEstimateCommand}" CommandParameter="{Binding SelectedEstimate}">
                                <Path Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                      Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Удалить смету" IsEnabled="{Binding CanEdit}"
                                    Command="{Binding DeleteEstimateCommand}" CommandParameter="{Binding SelectedEstimate}">
                                <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6"
                                      Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Сводка по смете -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="20,12" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Плановая стоимость" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="{Binding ItemsTotalDisplay}" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Позиций в смете" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="{Binding ItemsCount}" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Объект" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="{Binding SelectedEstimate.ProjectName, TargetNullValue=—}" FontWeight="SemiBold"
                                           FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="3" Style="{StaticResource Badge}" VerticalAlignment="Center"
                                    Background="{Binding SelectedEstimate.Status, Converter={StaticResource EstimateStatusToBrush}, ConverterParameter=background}">
                                <TextBlock Text="{Binding SelectedEstimate.StatusDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding SelectedEstimate.Status, Converter={StaticResource EstimateStatusToBrush}}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Позиции -->
                    <Grid Grid.Row="2">
                        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Items}" Margin="8,0,8,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Материал" Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MaterialName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SectionDisplay}" Style="{StaticResource Caption}"
                                                           FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding PlannedQuantity, StringFormat='{}{0:N2}', Mode=OneWay}" Width="100"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="Ед." Binding="{Binding UnitDisplay, Mode=OneWay}" Width="64" />
                                <DataGridTextColumn Header="Цена, BYN" Binding="{Binding PlannedUnitPrice, StringFormat='{}{0:N2}', Mode=OneWay}" Width="110"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="Сумма, BYN" Binding="{Binding PlannedCost, StringFormat='{}{0:N2}', Mode=OneWay}" Width="120"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Изменить"
                                                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}"
                                                          StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Удалить"
                                                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}"
                                                          StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyState Title="Выберите смету"
                                             Description="Слева показан перечень смет. Выберите смету, чтобы увидеть её позиции."
                                             Icon="{StaticResource IconEstimates}"
                                             Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <controls:EmptyState Title="В смете нет позиций"
                                             Description="Добавьте материалы с плановым количеством — на их основе будет считаться отклонение."
                                             Icon="{StaticResource IconMaterials}" ActionText="Добавить позицию"
                                             ActionCommand="{Binding AddItemCommand}"
                                             Visibility="{Binding IsItemsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Итог -->
                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <Grid>
                            <TextBlock Text="Итого по смете (план)" Style="{StaticResource Caption}" FontSize="12.5" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="Bold"
                                       Text="{Binding ItemsTotalDisplay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
