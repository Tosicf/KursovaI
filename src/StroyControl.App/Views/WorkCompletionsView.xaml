<UserControl xmlns:loc="clr-namespace:StroyControl.App.Localization"
        x:Class="StroyControl.App.Views.WorkCompletionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{loc:Tr 'Фактически выполненные работы по сметам'}" Style="{StaticResource Caption}" FontSize="12.5" />
                <TextBlock Text="{loc:Tr 'Акт учитывает объём работ и списывает израсходованные материалы со склада'}" Style="{StaticResource Caption}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr 'Обновить'}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PrintActCommand}" Margin="0,0,10,0"
                        ToolTip="{loc:Tr 'Печать акта выполненных работ по выбранной строке'}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconReport}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr 'Печать акта'}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                        IsEnabled="{Binding CanEdit}"
                        ToolTip="{Binding NoEstimateInWorkHint}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEstimates}" Stroke="White" StrokeThickness="1.9"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr 'Оформить акт работ'}" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid MaxWidth="320" HorizontalAlignment="Left">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,0,12,0" />
                    <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7"
                          Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="13,0,0,0"
                          VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="{loc:Tr 'Поиск по акту, смете, объекту'}" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12.5" VerticalAlignment="Center" Margin="38,0,10,0" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox Width="196" Margin="12,0,0,0" ItemsSource="{Binding ProjectFilterOptions}"
                              SelectedItem="{Binding SelectedProjectFilter, Mode=TwoWay}" />
                    <controls:PeriodPicker DataContext="{Binding Period}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr 'Актов'}" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr 'Работы'}" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="{Binding WorksCostDisplay}" FontWeight="SemiBold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr 'Материалы'}" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="{Binding MaterialsCostDisplay}" FontWeight="SemiBold" FontSize="15" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedCompletion}" Margin="8,6,8,8">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Tr 'Изменить…'}" InputGestureText="F2"
                                      Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{loc:Tr 'Удалить'}" InputGestureText="Del"
                                      Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr 'Печать акта работ…'}"
                                      Command="{Binding PlacementTarget.DataContext.PrintActCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{loc:Tr 'Добавить'}"
                                      Command="{Binding PlacementTarget.DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{loc:Tr 'Обновить'}" InputGestureText="Ctrl+R"
                                      Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Tr 'Документ'}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DocumentNumber}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource Caption}"
                                                   FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{loc:Tr 'Объект'}" Binding="{Binding ProjectName, Mode=OneWay}" Width="*" MinWidth="160" />
                        <DataGridTextColumn Header="{loc:Tr 'Смета'}" Binding="{Binding EstimateNumber, Mode=OneWay}" Width="130" />
                        <DataGridTextColumn Header="{loc:Tr 'Строк работ'}" Binding="{Binding ItemsCount, Mode=OneWay}" Width="104"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{loc:Tr 'Материалов'}" Binding="{Binding MaterialsCount, Mode=OneWay}" Width="104"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{loc:Tr 'Работы, BYN'}" Binding="{Binding WorksCost, StringFormat='{}{0:N2}', Mode=OneWay}" Width="118"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{loc:Tr 'Материалы, BYN'}" Binding="{Binding MaterialsCost, StringFormat='{}{0:N2}', Mode=OneWay}" Width="126"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{loc:Tr 'Итого, BYN'}" Binding="{Binding Total, StringFormat='{}{0:N2}', Mode=OneWay}" Width="118"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="{loc:Tr 'Оформил'}" Binding="{Binding AuthorName, Mode=OneWay}" Width="160" />

                        <DataGridTemplateColumn Header="" Width="118">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="{loc:Tr 'Печать акта'}"
                                                Command="{Binding DataContext.PrintActCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconReport}" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="{loc:Tr 'Изменить'}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconEdit}" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="{loc:Tr 'Удалить'}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}"
                                                  StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState Title="{loc:Tr 'Актов выполненных работ пока нет'}"
                                     Description="{loc:Tr 'Оформите акт по смете в работе, чтобы учесть объём работ и списать материалы.'}"
                                     Icon="{StaticResource IconEstimates}" ActionText="{loc:Tr 'Оформить акт работ'}"
                                     ActionCommand="{Binding AddCommand}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:EmptyState Title="{loc:Tr 'Акты не найдены'}"
                                     Description="{loc:Tr 'Измените объект или поисковый запрос.'}"
                                     Icon="{StaticResource IconSearch}"
                                     Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="{loc:Tr 'Загружаем акты работ…'}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
