<UserControl x:Class="StroyControl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18,24,28">

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Настройки рабочего места" Style="{StaticResource Caption}" FontSize="12.5" />
                        <TextBlock Text="Параметры сетевого подключения и полномочия текущей роли" Style="{StaticResource Caption}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding CheckConnectionCommand}"
                            IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBoolean}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Проверить подключение" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Подключение -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Подключение к базе данных" Style="{StaticResource SectionTitle}" />
                                <Border HorizontalAlignment="Right" Style="{StaticResource Badge}"
                                        Background="{Binding IsOnline, Converter={StaticResource BoolToBrush}, ConverterParameter=SuccessSoftBrush|DangerSoftBrush}">
                                    <TextBlock Text="{Binding HealthTitle}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{Binding IsOnline, Converter={StaticResource BoolToBrush}, ConverterParameter=SuccessBrush|DangerBrush}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Провайдер" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ProviderDisplay}" HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Сервер" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ServerDisplay}" HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="База данных" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding DatabaseDisplay}" HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Учётных записей в БД" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding UsersCountDisplay}" HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Материалов в БД" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding MaterialsCountDisplay}" HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />

                            <TextBlock Text="{Binding HealthMessage}" TextWrapping="Wrap" Style="{StaticResource Caption}" LineHeight="18" />

                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Строка подключения задаётся в appsettings.json" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="Server=.\SQLEXPRESS;Database=StroyControl;Trusted_Connection=True;"
                                               FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Учётная запись -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Текущая учётная запись" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="{Binding UserInitials}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UserRole}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Логин" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding UserLogin}" HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Последний вход" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding UserLastLogin}" HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Организация" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Organization}" HorizontalAlignment="Right" FontSize="12.5" />
                            </Grid>

                            <TextBlock Text="{Binding RoleDescription}" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       LineHeight="18" Margin="0,0,0,12" />

                            <TextBlock Text="Полномочия роли" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Capabilities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                            <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- О системе -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="О системе" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Приложение" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="СтройКонтроль" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Version, StringFormat=версия {0}}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Технологии" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="WPF · .NET 8 · EF Core" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0" />
                                <TextBlock Text="SQL Server 2019/2022" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Архитектура" Style="{StaticResource Caption}" FontSize="11" />
                                <TextBlock Text="MVVM, клиент-сервер" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0" />
                                <TextBlock Text="Core · Data · App" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16" />

                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18"
                                   Text="Курсовой проект: сетевое программное средство управления строительными материалами и анализа отклонений от сметы на строительном объекте. Данные хранятся в общей базе Microsoft SQL Server, доступ к ним разграничен по ролям." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:LoadingOverlay IsBusy="{Binding IsChecking}" Message="Проверяем подключение…" Margin="24" />
    </Grid>
</UserControl>
