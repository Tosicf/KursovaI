<UserControl x:Class="StroyControl.App.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconArchive}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                          Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Архив смет" Style="{StaticResource Caption}" FontSize="12.5" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Завершённые сметы: только просмотр, отчёты и выгрузка — изменение и удаление запрещены"
                           Style="{StaticResource Caption}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Обновить" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ShowReportCommand}"
                        CommandParameter="{Binding SelectedEstimate}" IsEnabled="{Binding CanViewReport}"
                        ToolTip="Печатный отчёт по архивной смете: работы, материалы, итоги">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEstimates}" Stroke="White" StrokeThickness="1.7"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Отчёт по смете" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Фильтры и сводка -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid MaxWidth="360" HorizontalAlignment="Left">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,0,12,0" />
                    <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7"
                          Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="13,0,0,0"
                          VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Поиск по номеру, названию, объекту" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12.5" VerticalAlignment="Center" Margin="38,0,10,0" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Смет в архиве" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="{Binding VisibleCount}" FontWeight="SemiBold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Плановая стоимость" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="{Binding TotalDisplay}" FontWeight="SemiBold" FontSize="15" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблица архива -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding EstimatesView}"
                          SelectedItem="{Binding SelectedEstimate}" Margin="8,6,8,8">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Отчёт по смете…"
                                      Command="{Binding PlacementTarget.DataContext.ShowReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanViewReport, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Обновить" InputGestureText="Ctrl+R"
                                      Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Смета" Width="*" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="11"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Объект" Binding="{Binding ProjectName, Mode=OneWay}" Width="190" />

                        <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount, Mode=OneWay}" Width="90"
                                            ElementStyle="{StaticResource NumericCell}" />

                        <DataGridTextColumn Header="План, BYN" Binding="{Binding PlannedTotal, StringFormat='{}{0:N2}', Mode=OneWay}"
                                            Width="140" ElementStyle="{StaticResource NumericCell}" />

                        <DataGridTemplateColumn Header="Статус" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding Status, Converter={StaticResource EstimateStatusToBrush}, ConverterParameter=background}">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource EstimateStatusToBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="В архиве с" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:dd.MM.yyyy}', Mode=OneWay}"
                                               FontSize="11.5" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Отчёт по смете"
                                            IsEnabled="{Binding DataContext.CanViewReport, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Command="{Binding DataContext.ShowReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconEstimates}" Stroke="{DynamicResource TextSecondaryBrush}"
                                              StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState Title="Архив пуст"
                                     Description="Подтверждённые сметы после завершения работ отправляются сюда командой «В архив» на странице «Сметы»."
                                     Icon="{StaticResource IconArchive}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:EmptyState Title="Сметы не найдены"
                                     Description="Измените поисковый запрос."
                                     Icon="{StaticResource IconSearch}"
                                     Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Загружаем архив смет…" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
