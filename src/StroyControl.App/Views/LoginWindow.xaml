<Window x:Class="StroyControl.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:StroyControl.App.Behaviors"
        xmlns:vm="clr-namespace:StroyControl.App.ViewModels"
        Title="СтройКонтроль — вход в систему"
        Width="1000"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Border CornerRadius="20" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.22" Color="#0B1220" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Брендовая панель -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20" MouseLeftButtonDown="OnWindowMouseDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#0B1220" />
                        <GradientStop Offset="1" Color="#16294A" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="46,44">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentBrush}">
                            <Path Data="{StaticResource IconBox}" Stroke="White" StrokeThickness="1.7" Width="22" Height="22"
                                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="СтройКонтроль" FontSize="19" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="сетевое управление материалами" FontSize="11.5" Foreground="#8FA6C6" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Материалы, сметы и отклонения — в одной системе"
                                   FontSize="27" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" LineHeight="34" />
                        <TextBlock Text="Клиент-серверное приложение для инженеров ПТО, снабженцев и прорабов строительной организации."
                                   Foreground="#9FB3D0" TextWrapping="Wrap" Margin="0,14,20,26" LineHeight="20" />

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#1E3A5F">
                                    <Path Data="{StaticResource IconCheck}" Stroke="#60A5FA" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="Учёт материалов, поставщиков и поступлений" Foreground="#CBD9EC" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#1E3A5F">
                                    <Path Data="{StaticResource IconCheck}" Stroke="#60A5FA" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="Сметы и фактические списания по объектам" Foreground="#CBD9EC" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#1E3A5F">
                                    <Path Data="{StaticResource IconCheck}" Stroke="#60A5FA" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="Анализ отклонений от сметы в реальном времени" Foreground="#CBD9EC" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#1E3A5F">
                                    <Path Data="{StaticResource IconCheck}" Stroke="#60A5FA" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="Разграничение прав доступа по ролям" Foreground="#CBD9EC" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="2" CornerRadius="12" Background="#14243D" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconDatabase}" Stroke="#60A5FA" StrokeThickness="1.6" Width="20" Height="20"
                                  Stretch="Uniform" VerticalAlignment="Center" StrokeStartLineCap="Round" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Environment.ProviderDisplay}" Foreground="#CBD9EC" FontSize="12" />
                                <TextBlock Text="{Binding Environment.ServerDisplay}" Foreground="#7E93B2" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Форма входа -->
            <Grid Grid.Column="1" Margin="46,30,46,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseClick" ToolTip="Закрыть">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                          Width="14" Height="14" Stretch="Uniform" StrokeStartLineCap="Round" />
                </Button>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Вход в систему" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Введите учётные данные, выданные администратором." Style="{StaticResource Caption}" Margin="0,6,0,26" />

                    <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" />
                    <PasswordBox behaviors:PasswordBoxHelper.BindPassword="True"
                                 behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0"
                            Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Height="44" Margin="0,22,0,0"
                            Command="{Binding SignInCommand}" IsDefault="True"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLock}" Stroke="White" StrokeThickness="1.7" Width="16" Height="16"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Войти" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Быстрый вход (демонстрационные роли)" Style="{StaticResource Caption}" Margin="0,26,0,10" />
                    <ItemsControl ItemsSource="{Binding DemoAccounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,8,8"
                                        Command="{Binding DataContext.UseDemoAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Login}"
                                        ToolTip="{Binding DisplayName}">
                                    <TextBlock FontSize="11.5">
                                        <Run Text="{Binding Role, Mode=OneWay}" />
                                        <Run Text="·" Foreground="{DynamicResource TextMutedBrush}" />
                                        <Run Text="{Binding Login, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="WPF · .NET 8" Style="{StaticResource Caption}" />
                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Environment.Organization}" Style="{StaticResource Caption}" />
                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Environment.Version, StringFormat=версия {0}}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
