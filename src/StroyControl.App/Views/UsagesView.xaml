<UserControl x:Class="StroyControl.App.Views.UsagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Фактический расход материалов по объектам" Style="{StaticResource Caption}" FontSize="12.5" />
                <TextBlock Text="Акты списания уменьшают остаток и формируют факт для анализа отклонений" Style="{StaticResource Caption}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Обновить" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" IsEnabled="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconOutgoing}" Stroke="White" StrokeThickness="1.9"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Оформить списание" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid MaxWidth="340" HorizontalAlignment="Left">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,0,12,0" />
                    <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.7"
                          Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="13,0,0,0"
                          VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Поиск по акту, материалу, объекту" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5" VerticalAlignment="Center" Margin="38,0,10,0" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>

                <ComboBox Grid.Column="1" Width="200" Margin="12,0,0,0" ItemsSource="{Binding ProjectFilterOptions}"
                          SelectedItem="{Binding SelectedProjectFilter, Mode=TwoWay}" />

                <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Актов" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Стоимость списаний" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="{Binding TotalCostDisplay}" FontWeight="SemiBold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Объектов охвачено" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock Text="{Binding ProjectsCovered}" FontWeight="SemiBold" FontSize="15" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedUsage}" Margin="8,6,8,8">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Документ" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DocumentNumber}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource Caption}"
                                                   FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Объект" Binding="{Binding ProjectName}" Width="*" MinWidth="170" />
                        <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="96"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="Ед." Binding="{Binding UnitDisplay}" Width="64" />
                        <DataGridTextColumn Header="Цена, BYN" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="110"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="Сумма, BYN" Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="120"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="Оформил" Binding="{Binding AuthorName}" Width="170" />

                        <DataGridTemplateColumn Header="" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Изменить"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Удалить"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}"
                                                  StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState Title="Списаний пока нет"
                                     Description="Оформите акт списания, чтобы сравнить фактический расход материалов со сметой."
                                     Icon="{StaticResource IconOutgoing}" ActionText="Оформить списание"
                                     ActionCommand="{Binding AddCommand}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:EmptyState Title="Списания не найдены"
                                     Description="Измените проект или поисковый запрос."
                                     Icon="{StaticResource IconSearch}"
                                     Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Загружаем списания…" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
