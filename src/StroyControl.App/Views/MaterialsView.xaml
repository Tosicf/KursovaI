<UserControl x:Class="StroyControl.App.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Справочник материалов и остатков на складе" Style="{StaticResource Caption}" FontSize="12.5" />
                <TextBlock Text="Учётная цена, страховой запас и привязка к поставщику" Style="{StaticResource Caption}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Обновить" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" IsEnabled="{Binding CanEdit}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Добавить материал" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Сводка и фильтры -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Позиций в справочнике" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Стоимость запасов" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding StockValueDisplay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ниже минимального запаса" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LowStockCount}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid MaxWidth="360" HorizontalAlignment="Left">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,0,12,0" />
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7"
                              Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="13,0,0,0"
                              VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Поиск по названию, артикулу, категории" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12.5" VerticalAlignment="Center" Margin="38,0,10,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>

                    <ComboBox Grid.Column="1" Width="190" Margin="12,0,0,0" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                    <ComboBox Grid.Column="2" Width="170" Margin="12,0,0,0" ItemsSource="{Binding StockFilters}"
                              SelectedItem="{Binding SelectedStockFilter, Mode=TwoWay}" />

                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Сбросить" Margin="8,0,0,0"
                            Height="38" Padding="10,0" Command="{Binding ResetFiltersCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedMaterial}" Margin="8,6,8,8">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Изменить…" InputGestureText="F2"
                                      Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Удалить" InputGestureText="Del"
                                      Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="Добавить"
                                      Command="{Binding PlacementTarget.DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Обновить" InputGestureText="Ctrl+R"
                                      Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Code, Mode=OneWay}" Width="120" />
                        <DataGridTemplateColumn Header="Наименование" Width="*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}"
                                                   FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ед." Binding="{Binding UnitDisplay, Mode=OneWay}" Width="66" />
                        <DataGridTextColumn Header="Цена, BYN" Binding="{Binding Price, StringFormat='{}{0:N2}', Mode=OneWay}" Width="104"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="Остаток" Binding="{Binding StockDisplay, Mode=OneWay}" Width="118"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTextColumn Header="Мин. запас" Binding="{Binding MinStock, StringFormat='{}{0:N0}', Mode=OneWay}" Width="96"
                                            ElementStyle="{StaticResource NumericCell}" />
                        <DataGridTemplateColumn Header="Статус" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding IsLowStock, Converter={StaticResource BoolToBrush}, ConverterParameter=DangerSoftBrush|SuccessSoftBrush}">
                                        <TextBlock Text="{Binding StockStatusDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding IsLowStock, Converter={StaticResource BoolToBrush}, ConverterParameter=DangerBrush|SuccessBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName, Mode=OneWay}" Width="170" />
                        <DataGridTemplateColumn Header="" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Изменить"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconEdit}" Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Удалить"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}"
                                                  StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState Title="Справочник материалов пуст"
                                     Description="Добавьте первый материал — он появится в сметах и документах движения."
                                     Icon="{StaticResource IconMaterials}" ActionText="Добавить материал"
                                     ActionCommand="{Binding AddCommand}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:EmptyState Title="Ничего не найдено"
                                     Description="Измените поисковый запрос или сбросьте фильтры, чтобы увидеть материалы."
                                     Icon="{StaticResource IconFilter}" ActionText="Сбросить фильтры"
                                     ActionCommand="{Binding ResetFiltersCommand}"
                                     Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Загружаем материалы…" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
