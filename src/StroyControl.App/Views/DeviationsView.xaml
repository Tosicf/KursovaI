<UserControl x:Class="StroyControl.App.Views.DeviationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Отклонения фактического расхода от сметы" Style="{StaticResource Caption}" FontSize="12.5" />
                <TextBlock Text="Порог внимания — 5 %, критично — 10 % от сметной стоимости позиции" Style="{StaticResource Caption}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Пересчитать" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Stroke="White" StrokeThickness="1.9"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Экспорт в CSV" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Сводные карточки -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <controls:KpiCard Title="План по сметам" Value="{Binding PlannedTotalDisplay}"
                              Caption="{Binding ScopeName}"
                              Icon="{StaticResource IconEstimates}"
                              Accent="{DynamicResource PurpleBrush}" IconBackground="{DynamicResource PurpleSoftBrush}"
                              Margin="0,0,14,14" MinWidth="250" />

            <controls:KpiCard Title="Фактические затраты" Value="{Binding ActualTotalDisplay}"
                              Caption="{Binding PositionsCount, StringFormat=позиций в отчёте: {0}}"
                              Icon="{StaticResource IconWallet}"
                              Accent="{DynamicResource WarningBrush}" IconBackground="{DynamicResource WarningSoftBrush}"
                              Margin="0,0,14,14" MinWidth="250" />

            <controls:KpiCard Title="Отклонение" Value="{Binding DeviationPercentDisplay}"
                              Caption="{Binding DeviationDirection}"
                              Icon="{StaticResource IconDeviations}"
                              Accent="{DynamicResource DangerBrush}" IconBackground="{DynamicResource DangerSoftBrush}"
                              Margin="0,0,14,14" MinWidth="230" />

            <controls:KpiCard Title="Критичных позиций" Value="{Binding CriticalCount}"
                              Caption="{Binding OverrunCount, StringFormat=с перерасходом: {0}}"
                              Icon="{StaticResource IconAlert}"
                              Accent="{DynamicResource InfoBrush}" IconBackground="{DynamicResource InfoSoftBrush}"
                              Margin="0,0,14,14" MinWidth="230" />
        </WrapPanel>

        <!-- Фильтры -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Объект" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                    <ComboBox Width="300" ItemsSource="{Binding ProjectOptions}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Отклонения" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                    <ComboBox Width="210" ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="24,0,0,10">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding RowsSummary}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0">
                        <Run Text="Внимание: " />
                        <Run Text="{Binding WarningCount, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}" />
                        <Run Text="   ·   Критично: " />
                        <Run Text="{Binding CriticalCount, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}" />
                        <Run Text="   ·   Экономия: " />
                        <Run Text="{Binding EconomyCount, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" />
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="3" Style="{StaticResource Badge}" VerticalAlignment="Bottom" Margin="0,0,0,8"
                        Padding="12,5"
                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=background}">
                    <TextBlock Text="{Binding SeverityDisplay, StringFormat=Сводная оценка: {0}}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                </Border>
            </Grid>
        </Border>

        <!-- Таблица отклонений -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow}" Margin="8,6,8,8" RowHeight="54">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Экспорт в CSV…"
                                      Command="{Binding PlacementTarget.DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanExport, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Обновить" InputGestureText="Ctrl+R"
                                      Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Копировать" InputGestureText="Ctrl+C"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Материал" Width="*" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MaterialName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ProjectName, Mode=OneWay}" />
                                            <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding Section, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Количество (факт / план)" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding ActualQuantity, StringFormat='{}{0:N2}', Mode=OneWay}" />
                                            <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding PlannedQuantity, StringFormat='{}{0:N2}', Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Run Text="{Binding Unit, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" />
                                        </TextBlock>
                                        <TextBlock FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{Binding IsOverrun, Converter={StaticResource BoolToBrush}, ConverterParameter=DangerBrush|SuccessBrush}">
                                            <Run Text="Δ " />
                                            <Run Text="{Binding QuantityDeviation, StringFormat='{}{0:+0.00;-0.00;0}', Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Цена (факт / план)" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding ActualPrice, StringFormat='{}{0:N2}', Mode=OneWay}" />
                                            <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding PlannedPrice, StringFormat='{}{0:N2}', Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10.5" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}">
                                            <Run Text="Δ " />
                                            <Run Text="{Binding PriceDeviation, StringFormat='{}{0:+0.00;-0.00;0}', Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Стоимость (факт / план), BYN" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <Run Text="{Binding ActualCost, StringFormat='{}{0:N2}', Mode=OneWay}" />
                                            <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal" />
                                            <Run Text="{Binding PlannedCost, StringFormat='{}{0:N2}', Mode=OneWay}" FontWeight="Normal"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{Binding IsOverrun, Converter={StaticResource BoolToBrush}, ConverterParameter=DangerBrush|SuccessBrush}">
                                            <Run Text="{Binding CostDeviation, StringFormat='{}{0:+0.00;-0.00;0.00}', Mode=OneWay}" />
                                            <Run Text=" BYN" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Отклонение" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviationPercent, StringFormat={}{0:+0.0;-0.0;0} %}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Оценка" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=background}">
                                        <TextBlock Text="{Binding SeverityDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState Title="Отклонений пока нет"
                                     Description="Отчёт строится по позициям смет и фактическим списаниям. Добавьте сметы и оформите списания материалов."
                                     Icon="{StaticResource IconDeviations}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:EmptyState Title="Нет позиций по выбранному фильтру"
                                     Description="Выберите другой объект или снимите ограничение по степени отклонения."
                                     Icon="{StaticResource IconFilter}"
                                     Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Считаем отклонения…" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
