<UserControl x:Class="StroyControl.App.Views.DeviationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Отклонения фактического расхода от сметы" Style="{StaticResource Caption}" FontSize="12.5" />
                <TextBlock Text="План сметы против фактических списаний · порог внимания 5 %, критично 10 %"
                           Style="{StaticResource Caption}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Пересчитать" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanExport}" Margin="0,0,10,0"
                        ToolTip="Выбрать формат файла отчёта">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.9"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Экспорт" Margin="8,0,6,0" VerticalAlignment="Center" />
                        <Path Data="M6 9l6 6 6-6" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                              Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                              StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Excel (.xlsx)"
                                      Command="{Binding PlacementTarget.DataContext.ExportExcelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanExport, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="CSV (.csv)"
                                      Command="{Binding PlacementTarget.DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanExport, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="PDF"
                                      Command="{Binding PlacementTarget.DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanExport, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenReportCommand}"
                        ToolTip="Печатный отчёт: предпросмотр, печать, Excel, CSV и PDF">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEstimates}" Stroke="White" StrokeThickness="1.7"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Отчёт" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Подсказка с формулами: всегда на виду, в самом верху формы -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource PurpleBrush}" StrokeThickness="1.7"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock Text="Как считается отклонение" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="По количеству" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Отклонение = факт − план. Показывает, больше или меньше материала израсходовано по сравнению со сметой." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="По цене" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Отклонение = фактическая цена − сметная цена, где фактическая цена = стоимость списаний ÷ израсходованное количество (средневзвешенная)." />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="По стоимости и оценка" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Отклонение = факт − план, процент = отклонение ÷ план × 100 %. До 5 % — в норме, 5–10 % — внимание, от 10 % — критично (по модулю). «+» — перерасход, «−» — экономия." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Сводные карточки -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
            <controls:KpiCard Title="План по сметам" Value="{Binding PlannedTotalDisplay}"
                              Caption="{Binding ScopeName}"
                              Icon="{StaticResource IconEstimates}"
                              Accent="{DynamicResource PurpleBrush}" IconBackground="{DynamicResource PurpleSoftBrush}"
                              Margin="0,0,14,14" MinWidth="250" />

            <controls:KpiCard Title="Фактические затраты" Value="{Binding ActualTotalDisplay}"
                              Caption="{Binding PositionsCount, StringFormat=позиций в отчёте: {0}}"
                              Icon="{StaticResource IconWallet}"
                              Accent="{DynamicResource WarningBrush}" IconBackground="{DynamicResource WarningSoftBrush}"
                              Margin="0,0,14,14" MinWidth="250" />

            <controls:KpiCard Title="Отклонение" Value="{Binding DeviationPercentDisplay}"
                              Caption="{Binding DeviationDirection}"
                              Icon="{StaticResource IconDeviations}"
                              Accent="{DynamicResource DangerBrush}" IconBackground="{DynamicResource DangerSoftBrush}"
                              Margin="0,0,14,14" MinWidth="230" />

            <controls:KpiCard Title="Критичных позиций" Value="{Binding CriticalCount}"
                              Caption="{Binding OverrunCount, StringFormat=с перерасходом: {0}}"
                              Icon="{StaticResource IconAlert}"
                              Accent="{DynamicResource InfoBrush}" IconBackground="{DynamicResource InfoSoftBrush}"
                              Margin="0,0,14,14" MinWidth="230" />
        </WrapPanel>

        <!-- Фильтры -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Объект" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                    <ComboBox Width="300" ItemsSource="{Binding ProjectOptions}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Отклонения" Style="{StaticResource FieldLabel}" Margin="2,0,0,6" />
                    <ComboBox Width="210" ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="24,0,0,10">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding RowsSummary}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0">
                        <Run Text="Внимание: " />
                        <Run Text="{Binding WarningCount, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}" />
                        <Run Text="   ·   Критично: " />
                        <Run Text="{Binding CriticalCount, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}" />
                        <Run Text="   ·   Экономия: " />
                        <Run Text="{Binding EconomyCount, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" />
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="3" Style="{StaticResource Badge}" VerticalAlignment="Bottom" Margin="0,0,0,8"
                        Padding="12,5"
                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=background}">
                    <TextBlock Text="{Binding SeverityDisplay, StringFormat=Сводная оценка: {0}}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                </Border>
            </Grid>
        </Border>

        <!-- Таблица отклонений -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="RowsGrid" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow}" Margin="8,6,8,8" RowHeight="54"
                          CanUserReorderColumns="False" SizeChanged="OnRowsGridSizeChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Печатный отчёт…"
                                      Command="{Binding PlacementTarget.DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Экспорт в CSV…"
                                      Command="{Binding PlacementTarget.DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding PlacementTarget.DataContext.CanExport, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Обновить" InputGestureText="Ctrl+R"
                                      Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Копировать" InputGestureText="Ctrl+C"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="10,7">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource PurpleBrush}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding ItemCount, StringFormat='позиций: {0}'}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <!-- Ширина не «звёздная»: в таблице с группировкой WPF при первом
                             показе окна считает Width="*" неправильно и выдавливает остальные
                             столбцы за край. Ширину подгоняет DeviationsView.xaml.cs
                             по фактическому размеру таблицы (FitNameColumn). -->
                        <DataGridTemplateColumn Header="Материал" Width="360" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MaterialName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ProjectName, Mode=OneWay}" />
                                            <Run Text="  ·  " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding Section, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Количество, факт / план" Width="196">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding ActualQuantity, StringFormat='{}{0:N2}', Mode=OneWay}" />
                                            <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding PlannedQuantity, StringFormat='{}{0:N2}', Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Run Text="{Binding Unit, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" />
                                        </TextBlock>
                                        <TextBlock FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{Binding IsOverrun, Converter={StaticResource BoolToBrush}, ConverterParameter=DangerBrush|SuccessBrush}">
                                            <Run Text="Δ " />
                                            <Run Text="{Binding QuantityDeviation, StringFormat='{}{0:+0.00;-0.00;0}', Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Цена, факт / план" Width="156">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding ActualPrice, StringFormat='{}{0:N2}', Mode=OneWay}" />
                                            <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding PlannedPrice, StringFormat='{}{0:N2}', Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10.5" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}">
                                            <Run Text="Δ " />
                                            <Run Text="{Binding PriceDeviation, StringFormat='{}{0:+0.00;-0.00;0}', Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Стоимость, BYN, факт / план" Width="222">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <Run Text="{Binding ActualCost, StringFormat='{}{0:N2}', Mode=OneWay}" />
                                            <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal" />
                                            <Run Text="{Binding PlannedCost, StringFormat='{}{0:N2}', Mode=OneWay}" FontWeight="Normal"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{Binding IsOverrun, Converter={StaticResource BoolToBrush}, ConverterParameter=DangerBrush|SuccessBrush}">
                                            <Run Text="{Binding CostDeviation, StringFormat='{}{0:+0.00;-0.00;0.00}', Mode=OneWay}" />
                                            <Run Text=" BYN" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Отклонение" Width="118">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviationPercent, StringFormat={}{0:+0.0;-0.0;0} %}"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Оценка" Width="124">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=background}">
                                        <TextBlock Text="{Binding SeverityDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState Title="Отклонений пока нет"
                                     Description="Отчёт строится по позициям смет и фактическим списаниям. Добавьте сметы и оформите списания материалов."
                                     Icon="{StaticResource IconDeviations}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:EmptyState Title="Нет позиций по выбранному фильтру"
                                     Description="Выберите другой объект или снимите ограничение по степени отклонения."
                                     Icon="{StaticResource IconFilter}"
                                     Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Считаем отклонения…" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
