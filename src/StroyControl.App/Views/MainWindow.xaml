<Window x:Class="StroyControl.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StroyControl.App.Controls"
        xmlns:vm="clr-namespace:StroyControl.App.ViewModels"
        Title="СтройКонтроль — управление строительными материалами"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Боковое меню ==================== -->
        <Border Grid.Column="0" Width="{Binding SidebarWidth}" Background="{DynamicResource SidebarGradientBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Orientation="Horizontal" Margin="20,24,20,22">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentBrush}">
                        <Path Data="{StaticResource IconBox}" Stroke="White" StrokeThickness="1.7" Width="20" Height="20"
                              Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="СтройКонтроль" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="материалы · сметы" FontSize="10.5" Foreground="#9A90AD" />
                    </StackPanel>
                </StackPanel>

                <!-- Навигация -->
                <ListBox Grid.Row="1" Style="{StaticResource NavigationListBox}"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{Binding Icon}" Stroke="#CFC7DE" StrokeThickness="1.6" Width="18" Height="18"
                                      Stretch="Uniform" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#EDE7F6" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window},
                                                                Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Подвал меню -->
                <StackPanel Grid.Row="2" Margin="12,0,12,18">
                    <Border Height="1" Background="#33264A" Margin="4,0,4,12" />

                    <Border CornerRadius="12" Background="#231A33" Padding="12,10" Margin="0,0,0,10"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="{Binding Organization}" Foreground="#EDE7F6" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="Сервер SQL Server" Foreground="#9A90AD" FontSize="11" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Environment.ServerDisplay}" Foreground="#B3AAC4" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Command="{Binding LogoutCommand}" ToolTip="Выйти из системы">
                            <Path Data="{StaticResource IconLogout}" Stroke="#C3BAD6" StrokeThickness="1.7" Width="17" Height="17"
                                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                Command="{Binding ToggleSidebarCommand}" ToolTip="Свернуть / развернуть меню">
                            <Path Stroke="#C3BAD6" StrokeThickness="1.7" Width="16" Height="16"
                                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconChevronLeft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Контент ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="26,0,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Organization}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource WarningSoftBrush}" Margin="0,0,10,0"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ДЕМО-РЕЖИМ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        </Border>

                        <!-- Сотрудники: только администратору -->
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenUsersCommand}" ToolTip="Сотрудники"
                                Margin="0,0,4,0"
                                Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource IconUsers}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                  Width="17" Height="17" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        </Button>

                        <!-- Настройки -->
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Настройки" Margin="0,0,4,0">
                            <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                  Width="17" Height="17" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        </Button>

                        <!-- Переключатель темы -->
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}"
                                ToolTip="{Binding ThemeTooltip}" Margin="0,0,4,0">
                            <Grid Width="17" Height="17">
                                <Path Data="{StaticResource IconMoon}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="Включена тёмная тема — нажмите для светлой" />
                                <Path Data="{StaticResource IconSun}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                      ToolTip="Включена светлая тема — нажмите для тёмной" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Обновить данные" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                  Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        </Button>

                        <Border Width="1" Height="28" Background="{DynamicResource BorderBrush}" Margin="10,0" />

                        <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding UserInitials}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Страница -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- Уведомления -->
        <controls:ToastHost Grid.Column="1" ItemsSource="{Binding Toasts.Toasts}"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,26,22" />
    </Grid>
</Window>
