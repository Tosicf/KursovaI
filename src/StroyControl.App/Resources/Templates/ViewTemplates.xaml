<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:StroyControl.App.ViewModels"
                    xmlns:views="clr-namespace:StroyControl.App.Views">

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MaterialsViewModel}">
        <views:MaterialsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
        <views:SuppliersView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
        <views:ProjectsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:EstimatesViewModel}">
        <views:EstimatesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DeliveriesViewModel}">
        <views:DeliveriesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UsagesViewModel}">
        <views:UsagesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DeviationsViewModel}">
        <views:DeviationsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UsersViewModel}">
        <views:UsersView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>

</ResourceDictionary>
