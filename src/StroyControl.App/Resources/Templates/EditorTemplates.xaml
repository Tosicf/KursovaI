<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:editors="clr-namespace:StroyControl.App.ViewModels.Editors"
                    xmlns:behaviors="clr-namespace:StroyControl.App.Behaviors">

    <!-- ==================== Материал ==================== -->
    <DataTemplate DataType="{x:Type editors:MaterialEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Артикул *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Категория" Style="{StaticResource FieldLabel}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Categories}"
                              Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Наименование *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Единица измерения" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay}" DisplayMemberPath="Display" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Учётная цена, BYN" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Остаток на складе" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Минимальный запас" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Поставщик" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <CheckBox Grid.Column="1" Content="Материал активен" IsChecked="{Binding IsActive}" VerticalAlignment="Bottom"
                          Margin="0,0,4,12" />
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Поставщик ==================== -->
    <DataTemplate DataType="{x:Type editors:SupplierEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Наименование *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="УНП" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Unp, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Контактное лицо" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Надёжность (1–5)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Объект ==================== -->
    <DataTemplate DataType="{x:Type editors:ProjectEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Шифр объекта *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Наименование *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Заказчик" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Ответственный прораб" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ManagerName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Договорная стоимость, BYN" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ContractSum, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Площадь строения, м²" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TotalArea, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              DisplayMemberPath="Display" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Дата начала" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Плановое окончание" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding PlannedEndDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Готовность, %" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ProgressPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Смета ==================== -->
    <DataTemplate DataType="{x:Type editors:EstimateEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Номер сметы *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Наименование *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Строительный объект *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              DisplayMemberPath="Display" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Параметры расчёта отчёта" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Наценка, %" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MarkupPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Прибыль, %" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Доля ЗП рабочих, %" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LaborSharePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Применяются в отчёте по смете: цена с наценкой, прибыль и зарплата рабочих."
                               Style="{StaticResource Caption}" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Позиция сметы ==================== -->
    <DataTemplate DataType="{x:Type editors:EstimateItemEditorViewModel}">
        <StackPanel>
            <CheckBox Content="Это работа (выполняется рабочими, со склада не списывается)"
                      IsChecked="{Binding IsWork, Mode=TwoWay}" Margin="2,0,0,14" />

            <!-- Материал из справочника -->
            <StackPanel Visibility="{Binding IsWork, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="Материал *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                          DisplayMemberPath="Name" />
                <TextBlock Text="{Binding StockHint}" Style="{StaticResource Caption}" FontSize="11" Margin="2,6,0,0" />
                <TextBlock Text="{Binding CataloguePriceHint}" Style="{StaticResource Caption}" FontSize="11" Margin="2,2,0,0" />
            </StackPanel>

            <!-- Работа -->
            <StackPanel Visibility="{Binding IsWork, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Наименование работы *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WorkName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Единица измерения *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WorkUnit, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding StockHint}" Style="{StaticResource Caption}" FontSize="11" Margin="2,6,0,0" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Раздел сметы *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Плановое количество *" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBox Text="{Binding PlannedQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"
                                 Padding="12,0,44,0" />
                        <TextBlock Text="{Binding UnitDisplay}" Style="{StaticResource Caption}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Плановая цена за единицу, BYN *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PlannedUnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Плановая стоимость" Style="{StaticResource FieldLabel}" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Height="40" Padding="12,0">
                        <TextBlock Text="{Binding PlannedCost, StringFormat={}{0:N2} BYN}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Поступление ==================== -->
    <DataTemplate DataType="{x:Type editors:DeliveryEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Номер накладной *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Дата поступления" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Поставщик *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Объект (необязательно)" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Номер ТТН" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Margin="0,18,0,8">
                <TextBlock Text="Строки поступления" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="30" Padding="10,0"
                        Command="{Binding AddItemCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Добавить строку" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                <!-- Style обязателен: без него DataGrid берёт системный шаблон строки
                     (белый фон) и в тёмной теме строка выглядит светлой полосой. -->
                <DataGrid Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeight="50" GridLinesVisibility="None"
                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          BorderThickness="0" IsReadOnly="True" MaxHeight="220">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Материал" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Materials, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Name" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Количество" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Цена, BYN" Width="126">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Сумма" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cost, StringFormat={}{0:N2}}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Удалить строку"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}"
                                              StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding ItemsSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                           Text="{Binding Total, StringFormat={}{0:N2} BYN}" />
            </Grid>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Списание ==================== -->
    <DataTemplate DataType="{x:Type editors:UsageEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Строительный объект *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Материал *" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
                <TextBlock Text="{Binding StockHint}" Style="{StaticResource Caption}" />
            </Border>

            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,8,0,0"
                    Visibility="{Binding IsOverStock, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconAlert}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.7"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding OverStockMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Количество *" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"
                                 Padding="12,0,44,0" />
                        <TextBlock Text="{Binding UnitDisplay}" Style="{StaticResource Caption}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Цена списания, BYN" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Дата списания" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Номер акта *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Смета (для связи расхода с планом)" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding FilteredEstimates}" SelectedItem="{Binding SelectedEstimate, Mode=TwoWay}"
                          DisplayMemberPath="Number" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="Стоимость списания" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                           Text="{Binding Cost, StringFormat={}{0:N2} BYN}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Сотрудник ==================== -->
    <DataTemplate DataType="{x:Type editors:UserEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="ФИО сотрудника *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Логин *" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Роль" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                              DisplayMemberPath="Display" />
                </StackPanel>
                <CheckBox Grid.Column="1" Content="Доступ разрешён" IsChecked="{Binding IsActive}" VerticalAlignment="Bottom"
                          Margin="0,0,4,12" />
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{Binding PasswordCaption}" Style="{StaticResource FieldLabel}" />
                <PasswordBox behaviors:PasswordBoxHelper.BindPassword="True"
                             behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
