<ResourceDictionary xmlns:loc="clr-namespace:StroyControl.App.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:editors="clr-namespace:StroyControl.App.ViewModels.Editors"
                    xmlns:behaviors="clr-namespace:StroyControl.App.Behaviors"
                    xmlns:controls="clr-namespace:StroyControl.App.Controls">

    <!-- ==================== Материал ==================== -->
    <DataTemplate DataType="{x:Type editors:MaterialEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Артикул *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Категория'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Categories}"
                              Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Наименование *'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Единица измерения'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay}" DisplayMemberPath="Display" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Учётная цена, BYN'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Остаток на складе'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr 'Минимальный запас'}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource InfoHint}"
                                   ToolTip="{loc:Tr 'Страховой порог: когда остаток опускается до него, материал попадает в дефицит. Можно пересчитать по сметам кнопкой «Мин. запас по сметам» на странице «Материалы»: минимум = потребность по сметам − остаток.'}" />
                    </StackPanel>
                    <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Поставщик'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <CheckBox Grid.Column="1" Content="{loc:Tr 'Материал активен'}" IsChecked="{Binding IsActive}" VerticalAlignment="Bottom"
                          Margin="0,0,4,12" />
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Примечание'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Поставщик ==================== -->
    <DataTemplate DataType="{x:Type editors:SupplierEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Наименование *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'УНП'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Unp, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Контактное лицо'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Телефон'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Надёжность (1–5)'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Адрес'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Примечание'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Объект ==================== -->
    <DataTemplate DataType="{x:Type editors:ProjectEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Шифр объекта *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Наименование *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Адрес'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Заказчик'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Ответственный прораб'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ManagerName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Договорная стоимость, BYN'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ContractSum, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Площадь строения, м²'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TotalArea, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Tr 'Статус'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              DisplayMemberPath="Display" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Дата начала'}" Style="{StaticResource FieldLabel}" />
                    <controls:DateField SelectedDate="{Binding StartDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Плановое окончание'}" Style="{StaticResource FieldLabel}" />
                    <controls:DateField SelectedDate="{Binding PlannedEndDate, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Tr 'Готовность, %'}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource InfoHint}" FontSize="11" Margin="4,0,0,6"
                                   ToolTip="{loc:Tr 'Готовность — это экспертная оценка физического выполнения работ по объекту: она вводится вручную в карточке объекта (0–100 %) и не вычисляется из документов. Не путайте её с исполнением бюджета: там процент считается автоматически как фактические затраты ÷ сметная стоимость × 100 % и ограничен 100 %.'}" />
                    </StackPanel>
                    <TextBox Text="{Binding ProgressPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Примечание'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Смета ==================== -->
    <DataTemplate DataType="{x:Type editors:EstimateEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Номер сметы *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Наименование *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Строительный объект *'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="{loc:Tr 'Статус меняется кнопками «Подтвердить» и «В архив» на странице смет.'}"
                               Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Дата сметы *'}" Style="{StaticResource FieldLabel}" />
                    <controls:DateField SelectedDate="{Binding Date, Mode=TwoWay}" MaxDate="{Binding MaxDate}" />
                    <TextBlock Text="{loc:Tr 'Месяц даты определяет, в какой группе списков и на главной панели показывается смета.'}"
                               Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr 'Параметры расчёта отчёта'}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{loc:Tr 'Наценка, %'}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MarkupPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Tr 'Прибыль, %'}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Tr 'Доля ЗП рабочих, %'}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LaborSharePercent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Tr 'Применяются в отчёте по смете: цена с наценкой, прибыль и зарплата рабочих.'}"
                               Style="{StaticResource Caption}" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Примечание'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Позиция сметы ==================== -->
    <DataTemplate DataType="{x:Type editors:EstimateItemEditorViewModel}">
        <StackPanel>
            <CheckBox Content="{loc:Tr 'Это работа (выполняется рабочими, со склада не списывается)'}"
                      IsChecked="{Binding IsWork, Mode=TwoWay}" Margin="2,0,0,14" />

            <!-- Материал из справочника -->
            <StackPanel Visibility="{Binding IsWork, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="{loc:Tr 'Материал *'}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                          DisplayMemberPath="Name" />
                <TextBlock Text="{Binding StockHint}" Style="{StaticResource Caption}" FontSize="11" Margin="2,6,0,0" />
                <TextBlock Text="{Binding CataloguePriceHint}" Style="{StaticResource Caption}" FontSize="11" Margin="2,2,0,0" />
            </StackPanel>

            <!-- Работа -->
            <StackPanel Visibility="{Binding IsWork, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{loc:Tr 'Наименование работы *'}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WorkName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Tr 'Единица измерения *'}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding WorkUnit, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding StockHint}" Style="{StaticResource Caption}" FontSize="11" Margin="2,6,0,0" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Раздел сметы *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Плановое количество *'}" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBox Text="{Binding PlannedQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"
                                 Padding="12,0,44,0" />
                        <TextBlock Text="{Binding UnitDisplay}" Style="{StaticResource Caption}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Плановая цена за единицу, BYN *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PlannedUnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Плановая стоимость'}" Style="{StaticResource FieldLabel}" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Height="40" Padding="12,0">
                        <TextBlock Text="{Binding PlannedCost, StringFormat={}{0:N2} BYN}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Примечание'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Поступление ==================== -->
    <DataTemplate DataType="{x:Type editors:DeliveryEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Номер накладной *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Дата поступления'}" Style="{StaticResource FieldLabel}" />
                    <controls:DateField SelectedDate="{Binding Date, Mode=TwoWay}" MaxDate="{Binding MaxDate}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Поставщик *'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Объект (необязательно)'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Номер счёта-фактуры'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Margin="0,18,0,8">
                <TextBlock Text="{loc:Tr 'Строки поступления'}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="30" Padding="10,0"
                        Command="{Binding AddItemCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr 'Добавить строку'}" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                <!-- Style обязателен: без него DataGrid берёт системный шаблон строки
                     (белый фон) и в тёмной теме строка выглядит светлой полосой. -->
                <DataGrid Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeight="50" GridLinesVisibility="None"
                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          BorderThickness="0" IsReadOnly="True" MaxHeight="220">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Tr 'Материал'}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Materials, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Name" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Количество'}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Цена, BYN'}" Width="126">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Сумма'}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cost, StringFormat={}{0:N2}}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{loc:Tr 'Удалить строку'}"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}"
                                              StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding ItemsSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                           Text="{Binding Total, StringFormat={}{0:N2} BYN}" />
            </Grid>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="{loc:Tr 'Примечание'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Списание ==================== -->
    <DataTemplate DataType="{x:Type editors:UsageEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Строительный объект *'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Материал *'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
                <TextBlock Text="{Binding StockHint}" Style="{StaticResource Caption}" />
            </Border>

            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,8,0,0"
                    Visibility="{Binding IsOverStock, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconAlert}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.7"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding OverStockMessage}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Количество *'}" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"
                                 Padding="12,0,44,0" />
                        <TextBlock Text="{Binding UnitDisplay}" Style="{StaticResource Caption}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Цена списания, BYN'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Дата списания'}" Style="{StaticResource FieldLabel}" />
                    <controls:DateField SelectedDate="{Binding Date, Mode=TwoWay}" MaxDate="{Binding MaxDate}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Номер акта *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Смета в работе (для связи расхода с планом)'}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding FilteredEstimates}" SelectedItem="{Binding SelectedEstimate, Mode=TwoWay}"
                          DisplayMemberPath="Number" />
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{loc:Tr 'Примечание'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="{loc:Tr 'Стоимость списания'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                           Text="{Binding Cost, StringFormat={}{0:N2} BYN}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Сотрудник ==================== -->
    <DataTemplate DataType="{x:Type editors:UserEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'ФИО сотрудника *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Логин *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Роль'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                              DisplayMemberPath="Display" />
                </StackPanel>
                <CheckBox Grid.Column="1" Content="{loc:Tr 'Доступ разрешён'}" IsChecked="{Binding IsActive}" VerticalAlignment="Bottom"
                          Margin="0,0,4,12" />
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Tr 'Телефон'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{Binding PasswordCaption}" Style="{StaticResource FieldLabel}" />
                <PasswordBox behaviors:PasswordBoxHelper.BindPassword="True"
                             behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== Акт выполненных работ ==================== -->
    <DataTemplate DataType="{x:Type editors:WorkCompletionEditorViewModel}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Смета в работе *'}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Estimates}" SelectedItem="{Binding SelectedEstimate, Mode=TwoWay}"
                              DisplayMemberPath="Number" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{loc:Tr 'Номер акта *'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Tr 'Дата акта'}" Style="{StaticResource FieldLabel}" />
                    <controls:DateField SelectedDate="{Binding Date, Mode=TwoWay}" MaxDate="{Binding MaxDate}" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
                <TextBlock Text="{Binding EstimateHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,18,0,8">
                <TextBlock Text="{loc:Tr 'Выполненные работы'}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="30" Padding="10,0"
                        Command="{Binding AddWorkCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr 'Добавить работу'}" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                <DataGrid Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding Works}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeight="50" GridLinesVisibility="None"
                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          BorderThickness="0" IsReadOnly="True" MaxHeight="190">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Tr 'Работа по смете'}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.WorkOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding EstimateItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="NameDisplay" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Количество'}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Цена, BYN'}" Width="118">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Сумма'}" Width="108">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cost, StringFormat={}{0:N2}}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{loc:Tr 'Удалить строку'}"
                                            Command="{Binding DataContext.RemoveWorkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}"
                                              StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="{Binding WorksSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0" />

            <Grid Margin="0,16,0,8">
                <TextBlock Text="{loc:Tr 'Материалы, списываемые со склада'}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="30" Padding="10,0"
                        Command="{Binding AddMaterialCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr 'Добавить материал'}" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                <DataGrid Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding MaterialRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeight="50" GridLinesVisibility="None"
                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          BorderThickness="0" IsReadOnly="True" MaxHeight="190">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Tr 'Материал по смете'}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.MaterialOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding MaterialItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="NameDisplay" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Количество'}" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Остаток'}" Width="126">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockHint}" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Цена, BYN'}" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}" Height="34" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Tr 'Сумма'}" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cost, StringFormat={}{0:N2}}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{loc:Tr 'Удалить строку'}"
                                            Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}"
                                              StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="{Binding MaterialsSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0" />

            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,10,0,0"
                    Visibility="{Binding HasOverStock, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconAlert}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.7"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding OverStockWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="{loc:Tr 'Примечание'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="{loc:Tr 'Стоимость акта'}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Text="{Binding TotalDisplay}" />
            </Grid>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
