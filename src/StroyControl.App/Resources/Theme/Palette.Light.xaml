<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================
         Светлая палитра в фиолетовой гамме: серо-лиловый холст, белые
         поверхности, сливовая навигация и фиолетовый акцент для действий.
         Ключи совпадают в обеих палитрах: ThemeManager подменяет словарь
         целиком, а стили ссылаются на кисти через DynamicResource.
         ================================================================== -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F4F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAF9FC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E6E3EE" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFC9DE" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#241C36" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B5470" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E87A3" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#F3EFFA" />

    <!-- Навигация: глубокий сливовый вместо нейтрального тёмно-синего. -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#1F1730" />
    <SolidColorBrush x:Key="SidebarElevatedBrush" Color="#2B2142" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#392B54" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#C3BAD6" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#0E8A5F" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E4F6EE" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FDF1DE" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCEAEC" />
    <SolidColorBrush x:Key="InfoBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#ECEAFE" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#9333EA" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#F5EAFE" />

    <!-- Акцент: фиолетовый для основных действий. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEE8FD" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#A66BFF" />
        <GradientStop Offset="1" Color="#6425D0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#160F23" />
        <GradientStop Offset="1" Color="#2A2043" />
    </LinearGradientBrush>

</ResourceDictionary>
