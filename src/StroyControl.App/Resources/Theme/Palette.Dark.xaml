<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================
         Тёмная палитра в фиолетовой гамме: почти чёрный лиловый холст,
         графитовые поверхности с фиолетовым подтоном и светлый фиолетовый
         акцент. Ключи совпадают со светлой палитрой.
         ================================================================== -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#131019" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1622" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#221C2D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2E2739" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#443A57" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECE7F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3AAC4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#837A96" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#F3EFFA" />

    <SolidColorBrush x:Key="SidebarBrush" Color="#0F0B16" />
    <SolidColorBrush x:Key="SidebarElevatedBrush" Color="#171122" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#241B33" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#B3AAC4" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#3CC98A" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#122C22" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#33260F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7A8A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1B25" />
    <SolidColorBrush x:Key="InfoBrush" Color="#8B93FF" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1E1B3A" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#2A2143" />

    <SolidColorBrush x:Key="AccentBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E2148" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#C4A6FF" />
        <GradientStop Offset="1" Color="#7C3AED" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0B0810" />
        <GradientStop Offset="1" Color="#1A1326" />
    </LinearGradientBrush>

</ResourceDictionary>
