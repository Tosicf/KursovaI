<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================
         Тёмная палитра
         Ключи совпадают в обеих палитрах: ThemeManager подменяет словарь
         целиком, а стили ссылаются на кисти через DynamicResource.
         ================================================================== -->

    <SolidColorBrush x:Key="AccentBrush" Color="#4C9AFF" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E2A3D" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12161C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161D26" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="BorderBrush" Color="#232D3B" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#33445A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6ECF5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B7C9" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7C8BA1" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0C1016" />
    <SolidColorBrush x:Key="SidebarElevatedBrush" Color="#131A23" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#A9B7C9" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#14301F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#362512" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1A1E" />
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#10293A" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#241B3A" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5AA9FF" />
        <GradientStop Offset="1" Color="#2563EB" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0B1118" />
        <GradientStop Offset="1" Color="#101A28" />
    </LinearGradientBrush>

</ResourceDictionary>
