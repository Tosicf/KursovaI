<UserControl xmlns:loc="clr-namespace:StroyControl.App.Localization"
        x:Class="StroyControl.App.Controls.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- День календаря: как в окне периода — в цветах темы. -->
        <Style x:Key="DayCellStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WeekDayStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Поле даты: текст слева, кнопка календаря справа. -->
        <Border x:Name="FieldBorder" Height="40" CornerRadius="10" SnapsToDevicePixels="True"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="Input" Height="Auto" Background="Transparent" BorderThickness="0"
                         Padding="12,0" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         ToolTip="{loc:Tr 'Дата в формате ДД.ММ.ГГГГ'}"
                         LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown" />

                <Button x:Name="ToggleButton" Grid.Column="1" Style="{StaticResource IconButton}"
                        Width="34" Height="30" Margin="0,0,4,0" Click="OnToggleClick"
                        ToolTip="{loc:Tr 'Выбрать дату в календаре'}">
                    <Path Data="{StaticResource IconCalendar}" Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=FieldBorder}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               VerticalOffset="6" HorizontalOffset="0">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="8" Width="252">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.16" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Шапка: ‹‹ год ‹ месяц, затем «Ноябрь 2026» и обратные стрелки. -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Click="OnPreviousYearClick" ToolTip="{loc:Tr 'Предыдущий год'}">
                                <Path Data="M0,0 L5,6 L0,12 M6,0 L11,6 L6,12" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6" Width="10" Height="11" Stretch="Uniform"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Click="OnPreviousMonthClick" ToolTip="{loc:Tr 'Предыдущий месяц'}">
                                <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="MonthTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Click="OnNextMonthClick" ToolTip="{loc:Tr 'Следующий месяц'}">
                                <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Click="OnNextYearClick" ToolTip="{loc:Tr 'Следующий год'}">
                                <Path Data="M0,0 L5,6 L0,12 M6,0 L11,6 L6,12" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6" Width="10" Height="11" Stretch="Uniform"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="7" x:Name="WeekHeader" />

                    <UniformGrid Columns="7" x:Name="DayGrid" />

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6,0,6" />

                    <Button Style="{StaticResource GhostButton}" Content="{loc:Tr 'Сегодня'}" HorizontalAlignment="Left"
                            Click="OnTodayClick" ToolTip="{loc:Tr 'Перейти к сегодняшней дате'}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
