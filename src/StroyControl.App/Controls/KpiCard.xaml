<UserControl x:Class="StroyControl.App.Controls.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="18" MinWidth="230">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Value, ElementName=Root}" FontSize="23" FontWeight="Bold" Margin="0,8,0,4" />
                <TextBlock Text="{Binding Caption, ElementName=Root}" FontSize="11.5"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                    Background="{Binding IconBackground, ElementName=Root}" VerticalAlignment="Top" Margin="8,0,0,0">
                <Path Data="{Binding Icon, ElementName=Root}" Stroke="{Binding Accent, ElementName=Root}"
                      StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
        </Grid>
    </Border>
</UserControl>
