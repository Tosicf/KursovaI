<UserControl x:Class="StroyControl.App.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
    <Border Background="#E6FFFFFF" CornerRadius="14">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="56" Height="56" HorizontalAlignment="Center">
                <Ellipse Width="48" Height="48" Stroke="{DynamicResource AccentSoftBrush}" StrokeThickness="4" />
                <Ellipse Width="48" Height="48" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
                         StrokeDashArray="3 5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Grid>
            <TextBlock Text="{Binding Message, ElementName=Root}" Margin="0,14,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
